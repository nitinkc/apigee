<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<KeyValueMapOperations async="false" continueOnError="false" enabled="true" name="KVM-ReadConfig" mapIdentifier="labs-config">
  <DisplayName>KVM-ReadConfig</DisplayName>
  <Scope>environment</Scope>
  <Get assignTo="kvm.cors.origin">
    <Key><Parameter>cors.origin</Parameter></Key>
  </Get>
  <Get assignTo="private.jwt.secret">
    <Key><Parameter>jwt.secret</Parameter></Key>
  </Get>
  <Get assignTo="kvm.cache.ttl">
    <Key><Parameter>cache.ttl</Parameter></Key>
  </Get>
  <ExpiryTimeInSecs>300</ExpiryTimeInSecs>
</KeyValueMapOperations>
