<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage async="false" continueOnError="false" enabled="true" name="AM-CORS-Preflight">
  <DisplayName>AM-CORS-Preflight</DisplayName>
  <Set>
    <Headers>
      <Header name="Access-Control-Allow-Origin">{kvm.cors.origin}</Header>
      <Header name="Access-Control-Allow-Methods">GET, POST, OPTIONS</Header>
      <Header name="Access-Control-Allow-Headers">authorization, content-type, x-apikey, x-no-cache</Header>
      <Header name="Access-Control-Max-Age">3600</Header>
    </Headers>
    <StatusCode>204</StatusCode>
  </Set>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <AssignTo createNew="false" type="response">response</AssignTo>
</AssignMessage>
