<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage async="false" continueOnError="false" enabled="true" name="AM-Error500">
  <DisplayName>AM-Error500</DisplayName>
  <Set>
    <Headers>
      <Header name="Access-Control-Allow-Origin">{kvm.cors.origin}</Header>
    </Headers>
    <Payload contentType="application/json">
      {"error": {"code": "INTERNAL", "message": "unexpected proxy fault", "fault": "{fault.name}"}}
    </Payload>
    <StatusCode>500</StatusCode>
  </Set>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <AssignTo createNew="false" type="response">response</AssignTo>
</AssignMessage>
