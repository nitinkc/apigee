<mxfile host="Electron"><diagram id="cicd-pipeline" name="cicd-pipeline"><mxGraphModel adaptiveColors="none" dx="920" dy="380" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="380" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="CI/CD: build once, promote the same revision" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#1e293b;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="160.0" y="8" width="600" height="26" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;lint&lt;/b&gt;&lt;br&gt;apigeelint --exit-code" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#92400e;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="130" height="80" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;import to dev&lt;/b&gt;&lt;br&gt;create bundle → revision N" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4f46e5;fontColor=#3730a3;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="170" y="110" width="130" height="80" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;test dev&lt;/b&gt;&lt;br&gt;curl / integration tests" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="130" height="80" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;deploy stage&lt;/b&gt;&lt;br&gt;apis deploy -v N" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4f46e5;fontColor=#3730a3;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="470" y="110" width="130" height="80" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;manual gate&lt;/b&gt;&lt;br&gt;human approval" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#9f1239;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="130" height="80" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;deploy prod&lt;/b&gt;&lt;br&gt;apis deploy -v N" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4f46e5;fontColor=#3730a3;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="770" y="110" width="130" height="80" as="geometry"/></mxCell><mxCell id="n9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#94a3b8;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#94a3b8;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#94a3b8;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#94a3b8;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#94a3b8;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;One revision N travels.&lt;/b&gt; Environment differences live in KVMs, target servers and product settings — never in the bundle." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;fontColor=#5b21b6;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="880" height="50" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Rollback&lt;/b&gt; = redeploy the previous good revision number (write it down before every promotion). Pipeline identity: service account, least privilege." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="880" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>