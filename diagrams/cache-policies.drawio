<mxfile host="Electron"><diagram id="cache-policies" name="cache-policies"><mxGraphModel adaptiveColors="none" dx="900" dy="430" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="430" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Cache policies: you control the key, scope and invalidation" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#1e293b;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150.0" y="8" width="600" height="26" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Cache resource&lt;/b&gt;&lt;br&gt;named store (or the default)&lt;br&gt;Scope: Global · Application · Proxy · Target · Exclusive" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;fontColor=#075985;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="240" height="100" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;PopulateCache&lt;/b&gt;&lt;br&gt;store value under CacheKey, TTL" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="220" height="70" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;LookupCache&lt;/b&gt;&lt;br&gt;read → variable; sets cachehit" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4f46e5;fontColor=#3730a3;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="220" height="70" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;InvalidateCache&lt;/b&gt;&lt;br&gt;delete entry (PurgeChildEntries)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#9f1239;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="220" height="70" as="geometry"/></mxCell><mxCell id="n7" value="write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#059669;fontSize=11;fontColor=#065f46;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4f46e5;fontSize=11;fontColor=#3730a3;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="delete" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#e11d48;fontSize=11;fontColor=#9f1239;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;ResponseCache&lt;/b&gt;&lt;br&gt;= lookup + populate wrapped around the whole response; honours Cache-Control if asked" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;fontColor=#5b21b6;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="220" height="100" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Use the explicit trio when&lt;/b&gt; you cache &lt;i&gt;data&lt;/i&gt; (config, a callout result, a token) not the whole response, need to invalidate on a write (POST/PUT/DELETE), or want a key that is not request-shaped.&lt;br&gt;&lt;b&gt;Key rules:&lt;/b&gt; include everything that changes the answer (tenant, version, locale) and nothing that does not." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="300" y="330" width="560" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>