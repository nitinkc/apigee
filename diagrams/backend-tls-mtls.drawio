<mxfile host="Electron"><diagram id="backend-tls-mtls" name="backend-tls-mtls"><mxGraphModel adaptiveColors="none" dx="900" dy="420" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="TLS and mutual TLS to the backend" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#1e293b;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150.0" y="8" width="600" height="26" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Apigee runtime&lt;/b&gt;&lt;br&gt;TargetEndpoint with SSLInfo" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4f46e5;fontColor=#3730a3;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="200" height="80" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Backend service&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="160" width="200" height="80" as="geometry"/></mxCell><mxCell id="n5" value="TLS: backend cert verified" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#059669;fontSize=11;fontColor=#065f46;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Truststore&lt;/b&gt;&lt;br&gt;CAs Apigee trusts. Verifies the &lt;b&gt;backend's&lt;/b&gt; certificate (Enabled=true, optional CommonName check)." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;fontSize=12;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="290" y="40" width="320" height="90" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Keystore (mTLS only)&lt;/b&gt;&lt;br&gt;Apigee's own certificate + key, presented when the backend sets ClientAuthEnabled=true. The backend verifies &lt;b&gt;Apigee&lt;/b&gt;." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;fontColor=#5b21b6;fontSize=12;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="290" y="280" width="320" height="100" as="geometry"/></mxCell><mxCell id="n8" value="trusts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#059669;fontSize=11;fontColor=#065f46;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="n6" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="presents" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7c3aed;fontSize=11;fontColor=#5b21b6;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="n7" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value='&lt;b&gt;Rule of thumb&lt;/b&gt;&lt;br&gt;Always verify the backend cert. Add mTLS when the backend can enforce it.&lt;br&gt;Never disable verification to "make it work".' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#9f1239;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="230" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>