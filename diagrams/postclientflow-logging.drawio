<mxfile host="Electron"><diagram id="postclientflow-logging" name="postclientflow-logging"><mxGraphModel adaptiveColors="none" dx="900" dy="400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="PostClientFlow: log after the client already has the answer" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#1e293b;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150.0" y="8" width="600" height="26" as="geometry"/></mxCell><mxCell id="n3" value="Client request" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4f46e5;fontColor=#3730a3;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="150" height="80" as="geometry"/></mxCell><mxCell id="n4" value="Proxy request flows" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4f46e5;fontColor=#3730a3;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="200" y="120" width="150" height="80" as="geometry"/></mxCell><mxCell id="n5" value="Target + response flows" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="370" y="120" width="150" height="80" as="geometry"/></mxCell><mxCell id="n6" value="Response sent to client" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="150" height="80" as="geometry"/></mxCell><mxCell id="n7" value="PostClientFlow&lt;br&gt;MessageLogging" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;fontColor=#5b21b6;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="710" y="120" width="150" height="80" as="geometry"/></mxCell><mxCell id="n8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#94a3b8;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#94a3b8;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#94a3b8;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#94a3b8;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="↑ client latency ends here" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#059669;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="205" width="320" height="30" as="geometry"/></mxCell><mxCell id="n13" value="Log system&lt;br&gt;(syslog / Cloud Logging)" style="shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;fontColor=#075985;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="710" y="260" width="160" height="70" as="geometry"/></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7c3aed;fontSize=11;fontColor=#5b21b6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Why here?&lt;/b&gt;&lt;br&gt;• cannot slow or alter the response&lt;br&gt;• runs even when the request &lt;b&gt;faulted&lt;/b&gt; (ideal for audit trails)&lt;br&gt;• can read final &lt;i&gt;response.status.code&lt;/i&gt; and timings&lt;br&gt;&lt;b&gt;Never log&lt;/b&gt; tokens, keys or personal data." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="30" y="260" width="640" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>