<mxfile host="Electron"><diagram id="apigee-x-networking" name="apigee-x-networking"><mxGraphModel adaptiveColors="none" dx="960" dy="450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Apigee X traffic path: northbound in, southbound out" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#1e293b;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="180.0" y="8" width="600" height="26" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Clients&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4f46e5;fontColor=#3730a3;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="110" height="70" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;External HTTPS LB&lt;/b&gt;&lt;br&gt;TLS cert, hostname&lt;br&gt;&lt;b&gt;Cloud Armor&lt;/b&gt; (WAF, rate, geo)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#92400e;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="170" y="170" width="170" height="90" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;PSC NEG / MIG&lt;/b&gt;&lt;br&gt;northbound" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="380" y="180" width="130" height="70" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Apigee runtime&lt;/b&gt;&lt;br&gt;(Google-managed project)&lt;br&gt;message processors, your proxies" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="550" y="150" width="200" height="130" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Backends&lt;/b&gt;&lt;br&gt;Cloud Run / GKE / on-prem" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;fontColor=#075985;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="800" y="170" width="140" height="90" as="geometry"/></mxCell><mxCell id="n8" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#94a3b8;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#94a3b8;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#94a3b8;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="southbound" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#059669;fontSize=11;fontColor=#065f46;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="Southbound reach: PSC service attachment (private), VPC peering, or Cloud NAT egress to the internet" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="500" y="290" width="440" height="40" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Control plane&lt;/b&gt;: Apigee API / console / apigeecli → IAM-authorised calls manage orgs, environments, revisions and deployments. Roles: apigee.admin, apigee.apiAdminV2, apigee.environmentAdmin, apigee.developerAdmin, apigee.analyticsViewer, apigee.readOnlyAdmin." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;fontColor=#5b21b6;fontSize=11;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="430" height="100" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Observability&lt;/b&gt;: Analytics (dashboards, custom reports, BigQuery export), Cloud Monitoring/Logging for the LB and runtime, Debug sessions for single transactions." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;fontSize=11;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="480" y="330" width="460" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>